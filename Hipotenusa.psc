Algoritmo Hipotenusa
	Definir cateto, cateto2, Hipotenusaa Como Real
	Escribir "Ingrese el valor del primer cateto: "
	Leer cateto
	Escribir "Ingrese el valor del segundo cateto: "
	Leer cateto2
	Hipotenusaa= raiz(cateto^2+cateto2^2)
	Escribir "La Hipotenusa es: " ,Hipotenusaa
	
FinAlgoritmo