Algoritmo OperacionDeModulo
    Definir num1, num2, elresultado Como Real
    Escribir "Ingrese el primer número:"
    Leer num1
    Escribir "Ingrese el segundo número:"
    Leer num2
    elresultado <- num1 MOD num2
    Escribir "El módulo de ", num1, " y ", num2, " es: ", elresultado
FinAlgoritmo