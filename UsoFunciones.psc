Algoritmo UsoFunciones 
	Definir n,seno,coseno,tangente,raices,in,log10 como real 
	Escribir " ingresa un numero "
	Leer n
	seno= sen(n)
	coseno=(n)
	tangente=tan(n)
	raices= Raiz(n)
	in=Ln(n)
	log10=ln(n)/ln(10)
	Escribir "numero",n
	escribir "seno",seno
	escribir "coseno",coseno
	escribir "tangente",tangente
	escribir"raices",raices
	escribir "Ln",in
	escribir" log 10",log10
FinAlgoritmo
